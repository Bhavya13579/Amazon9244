import csv
import random
from datetime import date, timedelta

random.seed(42)

# -----------------------
# CONFIG
# -----------------------
CUSTOMERS = 2000
PRODUCTS = 1000
ORDERS = 10000
ORDER_ITEMS = 25000

# -----------------------
# HELPERS
# -----------------------
def random_date(start, end):
    delta = (end - start).days
    return start + timedelta(days=random.randint(0, delta))

# -----------------------
# CUSTOMERS
# -----------------------
with open("customers.csv", "w", newline="") as f:
    writer = csv.writer(f)
    writer.writerow(["customer_id", "region_id", "is_prime", "signup_date"])

    for cid in range(1, CUSTOMERS + 1):
        writer.writerow([
            cid,
            random.randint(1, 3),
            random.choice([0, 1]),
            random_date(date(2021, 1, 1), date(2024, 12, 31))
        ])

# -----------------------
# PRODUCTS
# -----------------------
categories = {
    "Electronics": (500, 5000, 0.75),
    "Home": (300, 3000, 0.6),
    "Apparel": (400, 2000, 0.55),
    "Beauty": (200, 1500, 0.5),
    "Books": (150, 800, 0.65),
}

with open("products.csv", "w", newline="") as f:
    writer = csv.writer(f)
    writer.writerow(["product_id", "product_name", "category", "price", "cost"])

    for pid in range(1, PRODUCTS + 1):
        category = random.choice(list(categories.keys()))
        low, high, margin = categories[category]
        price = round(random.uniform(low, high), 2)
        cost = round(price * margin, 2)

        writer.writerow([
            pid,
            f"{category} Product {pid}",
            category,
            price,
            cost
        ])

# -----------------------
# ORDERS
# -----------------------
statuses = ["DELIVERED", "CANCELLED", "RETURNED"]

with open("orders.csv", "w", newline="") as f:
    writer = csv.writer(f)
    writer.writerow(["order_id", "customer_id", "order_date", "order_status"])

    for oid in range(1, ORDERS + 1):
        writer.writerow([
            oid,
            random.randint(1, CUSTOMERS),
            random_date(date(2022, 1, 1), date(2024, 12, 31)),
            random.choices(statuses, weights=[70, 15, 15])[0]
        ])

# -----------------------
# ORDER ITEMS
# -----------------------
with open("order_items.csv", "w", newline="") as f:
    writer = csv.writer(f)
    writer.writerow(["order_item_id", "order_id", "product_id", "quantity"])

    for oi in range(1, ORDER_ITEMS + 1):
        writer.writerow([
            oi,
            random.randint(1, ORDERS),
            random.randint(1, PRODUCTS),
            random.randint(1, 4)
        ])

print("CSV generation complete.")
